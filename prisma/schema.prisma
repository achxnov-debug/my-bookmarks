generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Platform {
  instagram
  tiktok
  twitter
  youtube
  telegram
  linkedin
  reddit
  other
}

enum ContentType {
  video
  image
  text
  thread
  article
}

enum Theme {
  light
  dark
  system
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  theme     Theme    @default(system)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookmarks Bookmark[]
  boards    Board[]

  @@map("users")
}

model Bookmark {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  url          String
  title        String?
  description  String?
  author       String?
  thumbnailUrl String?     @map("thumbnail_url")
  aiSummary    String?     @map("ai_summary")
  platform     Platform    @default(other)
  contentType  ContentType @default(text)
  isPinned     Boolean     @default(false) @map("is_pinned")
  savedAt      DateTime    @default(now()) @map("saved_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags       BookmarkTag[]
  boards     BoardBookmark[]
  embedding  Embedding?

  @@unique([userId, url])
  @@index([userId, savedAt(sort: Desc)])
  @@index([userId, platform])
  @@map("bookmarks")
}

model Tag {
  id            String        @id @default(uuid())
  name          String        @unique
  color         String        @default("#748ffc")
  isAiGenerated Boolean       @default(false) @map("is_ai_generated")
  createdAt     DateTime      @default(now()) @map("created_at")

  bookmarks BookmarkTag[]

  @@map("tags")
}

model BookmarkTag {
  bookmarkId String   @map("bookmark_id")
  tagId      String   @map("tag_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, tagId])
  @@map("bookmark_tags")
}

model Board {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  emoji       String   @default("📁")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks BoardBookmark[]

  @@unique([userId, name])
  @@map("boards")
}

model BoardBookmark {
  boardId    String   @map("board_id")
  bookmarkId String   @map("bookmark_id")
  addedAt    DateTime @default(now()) @map("added_at")
  sortOrder  Int      @default(0) @map("sort_order")

  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@id([boardId, bookmarkId])
  @@map("board_bookmarks")
}

model Embedding {
  id          String                      @id @default(uuid())
  bookmarkId  String                      @unique @map("bookmark_id")
  embedding   Unsupported("vector(1536)")
  textContent String                      @map("text_content")
  createdAt   DateTime                    @default(now()) @map("created_at")

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@map("embeddings")
}
